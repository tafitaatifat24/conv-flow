# Application Settings
APP_NAME=conv-flow
APP_VERSION=0.1.0
DEBUG=false

# Database Settings
DATABASE_URL=sqlite:///./conv_flow.db
DATABASE_ECHO=false

# LLM Provider Settings
# Options: openai, anthropic, gemini, local
LLM_PROVIDER=openai

# OpenAI Settings (if using OpenAI)
OPENAI_API_KEY=AQ.Ab8RN6JpD4MR48mRsDktMYSliw6Ah0dukna-QhRwzfm-TMCF3g
OPENAI_MODEL=gpt-4

# Anthropic Settings (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google Gemini Settings (if using Gemini)
GEMINI_API_KEY=AQ.Ab8RN6JpD4MR48mRsDktMYSliw6Ah0dukna-QhRwzfm-TMCF3g
GEMINI_MODEL=gemini-3.5-flash-lite

# Local LLM Settings (if using local LLM)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral

# LLM Behavior Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
